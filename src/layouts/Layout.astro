---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  robots?: string;
}

const defaultTitle = "Alain Didier Noutchegueme | Penseur & Concepteur de Systèmes";
const defaultDescription = "Extraire les structures sous-jacentes du chaos. Recherche en géométrie spectrale, stratégie d'intelligence artificielle et ingénierie de la cognition.";
const defaultImage = "/Alain-Didier-Noutchegueme/alaindidier2.jpg";

const { 
  title = defaultTitle, 
  description = defaultDescription, 
  image = defaultImage,
  type = "website",
  robots = "index, follow"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);
const resolvedImage = new URL(image, Astro.site || Astro.url);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/Alain-Didier-Noutchegueme/favicon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content="R2JjW4bidVcqEIn_x2LxiAs96N2BclRoTQyf04LlFRA" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://adn2035.github.io/Alain-Didier-Noutchegueme/#person",
      "name": "Alain Didier Noutchegueme",
      "givenName": "Alain Didier",
      "familyName": "Noutchegueme",
      "alternateName": ["Alain Noutchegueme", "Didier Noutchegueme", "A. D. Noutchegueme"],
      "url": "https://adn2035.github.io/Alain-Didier-Noutchegueme/",
      "image": "https://adn2035.github.io/Alain-Didier-Noutchegueme/alaindidier2.jpg",
      "jobTitle": ["PhD Candidate en Mathématiques", "Stratège IA"],
      "worksFor": [
        {
          "@type": "Organization",
          "name": "Université de Montréal"
        },
        {
          "@type": "Organization",
          "name": "Kemetica"
        }
      ],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Université de Montréal"
      },
      "knowsAbout": ["Géométrie Spectrale", "Analyse Géométrique", "Intelligence Artificielle", "Stratégie Algorithmique"],
      "sameAs": [
        "https://www.linkedin.com/in/alain-didier-noutchegueme",
        "https://www.dms.umontreal.ca/fr/repertoire-departement/etudiants-cycles-superieurs/portrait/noutcheguea",
        "https://scholar.google.ca/citations?user=NhBBSBIAAAAJ&hl=en&oi=sra",
        "https://www.ictp.it/news/finding-answers-big-questions",
        "https://arxiv.org/search/math?searchtype=author&query=Noutchegueme%2C+A+D",
        "https://www.researchgate.net/profile/Alain-Didier-Noutchegueme",
        "https://www.issea-cemac.org/issea/fr/etudiants/ingenieur-statisticien-economiste/ise-2/2019/noutchegueme-alain-didier",
        "https://afrik-view.com/author/adn/",
        "https://dms.umontreal.ca/fr/ressources-et-services/journee-decouverte-des-mathematiques",
        "https://www.amazon.ca/-/fr/LUniversit%C3%A9-Yaound%C3%A9-%C3%A0-Kit-Survie/dp/B0CHKY19YW/ref=sr_1_3?dib=eyJ2IjoiMSJ9.ynZ8AcRZ-qLKqlEXdWE61A.UnzAoT8E3Ivwl9y9OfK5sxLewkghquSm4NH49mPoms8&dib_tag=se&qid=1784431694&refinements=p_27%3AAlain+Didier+NOUTCHEGUEME&s=books&sr=1-3",
        "https://www.youtube.com/watch?v=c3labsmBXEc",
        "https://www.youtube.com/watch?v=MQ2rnfpPq2o&t=237s",
        "https://www.youtube.com/watch?v=-FXi5eXRhuU&t=1s",
        "https://www.youtube.com/watch?v=WFecKOkuWss",
        "https://www.youtube.com/watch?v=Jl3R4Q0_2Og",
        "https://www.youtube.com/watch?v=fdnztuYpHp8&t=120s",
        "https://www.youtube.com/watch?v=Ki51ZtuLXU8&t=4s",
        "https://www.youtube.com/watch?v=wLvYBmoNF5Y&t=630s",
        "https://www.youtube.com/watch?v=yO0tQQsW6e8&t=2s",
        "https://www.youtube.com/watch?v=_wi21sSA_BY&t=840s",
        "https://www.youtube.com/@didiernoutch3784"
      ]
    }
    </script>

    <meta name="citation_author" content="Noutchegueme, Alain Didier" />
    <meta name="citation_title" content="Recherches et Essais en Géométrie Spectrale et Stratégie IA" />
    <meta name="citation_public_url" content={canonicalURL} />
    <meta name="DC.creator" content="Alain Didier Noutchegueme" />
    <meta name="DC.subject" content="Spectral Geometry; Artificial Intelligence; Systemic Analysis" />
    <meta name="DC.type" content="Text.Homepage" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:site_name" content="Alain Didier Noutchegueme" />

    <slot name="head" />
  </head>
  
  <body class="bg-zinc-50 text-zinc-900 font-sans antialiased selection:bg-blue-100 selection:text-blue-900 flex flex-col min-h-screen">
    
    <header class="border-b border-zinc-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-[1100px] mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/Alain-Didier-Noutchegueme/" class="font-mono font-bold text-zinc-900 tracking-[0.2em] text-xs shrink-0">A.D.N.</a>
        
        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs uppercase tracking-wider font-mono text-zinc-600">
          <a href="/Alain-Didier-Noutchegueme/manifeste/" class="hover:text-zinc-900 transition-colors">Vision</a>
          <a href="/Alain-Didier-Noutchegueme/recherche/" class="hover:text-zinc-900 transition-colors">Recherche</a>
          <a href="/Alain-Didier-Noutchegueme/consultation/" class="hover:text-zinc-900 transition-colors">Stratégie IA</a>
          <!-- Modification de l'onglet : Routage et texte mis à jour -->
          <a href="/Alain-Didier-Noutchegueme/vulgarisation/" class="hover:text-zinc-900 transition-colors">Vulgarisation</a>
        </nav>
        
        <a href="/Alain-Didier-Noutchegueme/cv.pdf" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-block text-xs font-mono uppercase tracking-widest bg-zinc-900 text-white px-3 py-1.5 rounded hover:bg-zinc-800 transition-colors shrink-0">CV</a>
      </div>
    </header>

    <div class="flex-grow">
      <slot />
    </div>

    <footer class="py-12 text-center text-xs text-zinc-400 border-t border-zinc-200/60 font-mono mt-auto">
      <p>© {new Date().getFullYear()} Alain Didier Noutchegueme (Alain Noutchegueme). Tous droits réservés.</p>
      <p class="mt-1">Recherche fondamentale à l'Université de Montréal • Stratégie IA chez Kemetica</p>
    </footer>

  </body>
</html>