---
import Layout from '../../layouts/Layout.astro';

// Calcul dynamique des chemins avec les noms exacts des fichiers PDF
const basePath = import.meta.env.BASE_URL;
const docs = {
  lassitude: `${basePath}lassitude_magicien.pdf`,
  dictature: `${basePath}dictature_reel.pdf`,
  conjecture: `${basePath}conjecture_chatgpt.pdf`,
  tumeur: `${basePath}tumeur.pdf`,
  moustique: `${basePath}moustique.pdf`,
  clarke: `${basePath}clarke.pdf`,
  marcheur: `${basePath}marcheur.pdf`,
  equation: `${basePath}equation.pdf`
};
---

<Layout title="Alain Didier Noutchegueme | Vulgarisation Scientifique">
  
  <main class="max-w-[900px] mx-auto px-6 py-24 md:py-32">
    
    <a href="/Alain-Didier-Noutchegueme/" class="group inline-flex items-center text-xs font-mono tracking-widest text-zinc-400 hover:text-zinc-900 mb-16 transition-colors uppercase">
      <svg class="w-3 h-3 mr-2 opacity-50 group-hover:opacity-100 group-hover:-translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Retour à l'accueil
    </a>

    <header class="mb-20 max-w-[700px]">
      <h1 class="text-4xl md:text-5xl font-medium text-zinc-900 tracking-tight leading-[1.1] mb-6">
        Vulgarisation
      </h1>
      <p class="text-[1.1rem] text-zinc-600 leading-[1.8] font-light border-l-[1.5px] border-zinc-900 pl-6">
        Démocratiser l'abstraction. Des formats courts conçus pour extraire l'essence des concepts mathématiques et technologiques sans en sacrifier la rigueur.
      </p>
    </header>

    <div class="space-y-16">

      <!-- Article 1 : La lassitude et le magicien -->
      <article class="border border-zinc-200/60 rounded-[2rem] overflow-hidden shadow-sm bg-white/40">
        <div class="p-6 md:p-8 bg-zinc-50/80 border-b border-zinc-200/60 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest bg-white border border-zinc-200 px-2 py-1 rounded-md">Chronique Technologique</span>
              <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">25 Août 2026</span>
            </div>
            <h2 class="text-2xl font-medium text-zinc-900">La lassitude et le magicien</h2>
            <p class="text-sm text-zinc-500 font-light mt-2 max-w-xl">"Le marché a compris la leçon : on n'investit plus dans la baguette magique, on investit dans le magicien."</p>
          </div>
          
          <a href={docs.lassitude} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 rounded-xl bg-zinc-900 text-white text-sm font-medium hover:bg-zinc-800 transition-all shrink-0">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Ouvrir le PDF
          </a>
        </div>
        
        <div class="w-full h-[600px] md:h-[900px] bg-zinc-100 relative border-t border-zinc-200/60">
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-8 z-0">
            <p class="text-zinc-500 font-light mb-4">Votre navigateur mobile empêche l'aperçu direct de ce document.</p>
            <a href={docs.lassitude} class="text-blue-600 font-medium underline">Ouvrir le document</a>
          </div>
          <iframe 
            src={`${docs.lassitude}#toolbar=0&view=FitH`}
            loading="lazy"
            class="w-full h-full relative z-10 border-0 bg-white" 
            title="Aperçu : La lassitude et le magicien">
          </iframe>
        </div>
      </article>

      <!-- Article 2 : La dictature du réel -->
      <article class="border border-zinc-200/60 rounded-[2rem] overflow-hidden shadow-sm bg-white/40">
        <div class="p-6 md:p-8 bg-zinc-50/80 border-b border-zinc-200/60 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest bg-white border border-zinc-200 px-2 py-1 rounded-md">Chronique Mathématique</span>
              <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">28 Juil 2026</span>
            </div>
            <h2 class="text-2xl font-medium text-zinc-900">La dictature du réel</h2>
            <p class="text-sm text-zinc-500 font-light mt-2 max-w-xl">"Soyez obsédés par la compréhension, jamais par la bonne réponse." Le goût de l'échec face à l'utilitarisme.</p>
          </div>
          
          <a href={docs.dictature} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 rounded-xl bg-zinc-900 text-white text-sm font-medium hover:bg-zinc-800 transition-all shrink-0">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Ouvrir le PDF
          </a>
        </div>
        
        <div class="w-full h-[600px] md:h-[900px] bg-zinc-100 relative border-t border-zinc-200/60">
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-8 z-0">
            <p class="text-zinc-500 font-light mb-4">Votre navigateur mobile empêche l'aperçu direct de ce document.</p>
            <a href={docs.dictature} class="text-blue-600 font-medium underline">Ouvrir le document</a>
          </div>
          <iframe 
            src={`${docs.dictature}#toolbar=0&view=FitH`}
            loading="lazy"
            class="w-full h-full relative z-10 border-0 bg-white" 
            title="Aperçu : La dictature du réel">
          </iframe>
        </div>
      </article>

      <!-- Article 3 : La conjecture de ChatGPT -->
      <article class="border border-zinc-200/60 rounded-[2rem] overflow-hidden shadow-sm bg-white/40">
        <div class="p-6 md:p-8 bg-zinc-50/80 border-b border-zinc-200/60 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest bg-white border border-zinc-200 px-2 py-1 rounded-md">Chronique Mathématique</span>
              <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">30 Juin 2026</span>
            </div>
            <h2 class="text-2xl font-medium text-zinc-900">La conjecture de ChatGPT</h2>
            <p class="text-sm text-zinc-500 font-light mt-2 max-w-xl">"La machine produit des architectures théoriques. Le mathématicien garantit qu'elles tiennent."</p>
          </div>
          
          <a href={docs.conjecture} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 rounded-xl bg-zinc-900 text-white text-sm font-medium hover:bg-zinc-800 transition-all shrink-0">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Ouvrir le PDF
